# GEMINI_API_KEY: Required for server-side Gemini AI receipt scanning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for CORS allowlist and OAuth callbacks).
APP_URL="MY_APP_URL"

# Public Firebase Web configuration (inject via environment variables or CI Secrets; do not commit keys)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Optional GitHub repository slug (owner/repo) for in-app APK update checks
VITE_GITHUB_REPO=""
